# Copy to .env. Keep real credentials only in .env; never commit or share them.
# Neon: paste the pooled connection URI from Neon. POSTGRES_URL is also accepted.
DATABASE_URL=
POSTGRES_URL=

# Required only when running the optional local Postgres profile.
POSTGRES_PASSWORD=

SEWASETU_SECRET_KEY=
SEWASETU_ADMIN_USERNAME=
SEWASETU_ADMIN_PASSWORD=

# AI assistant (OpenAI-compatible HTTPS chat-completions endpoint).
# Leave blank to disable AI features. Never commit or share a real API key.
# Citizen questions are sent to this provider; application records and uploads are not.
SEWASETU_AI_API_URL=
SEWASETU_AI_API_KEY=
SEWASETU_AI_MODEL=
