# Copy to .env. Keep real credentials only in .env; never commit or share them.
# Neon: paste the pooled connection URI from Neon. POSTGRES_URL is also accepted.
DATABASE_URL=
POSTGRES_URL=

# Required only when running the optional local Postgres profile.
POSTGRES_PASSWORD=

SEWASETU_SECRET_KEY=
SEWASETU_ADMIN_USERNAME=
SEWASETU_ADMIN_PASSWORD=
